{
  "name": "linkedin-post-collector",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "scrape": "bun run src/scraper/index.ts",
    "rescrape": "bun src/scraper/cli/rescrape.ts",
    "hn": "bun src/briefing/cli/hn.ts",
    "lobsters": "bun src/briefing/cli/lobsters.ts",
    "rss": "bun src/briefing/cli/rss.ts",
    "briefing": "bun src/briefing/cli/briefing.ts",
    "top-posts": "bun src/analytics/cli/top-posts.ts",
    "post-patterns": "bun src/analytics/cli/post-patterns.ts",
    "wiki": "bun src/wiki/cli/wiki.ts",
    "office": "bun src/office/cli.ts",
    "logo": "bun src/logo/logo.ts",
    "generate-image": "bun src/images/cli/generate.ts",
    "select-variant": "bun src/images/cli/select-variant.ts",
    "post-lane": "bun src/scraper/cli/post-lane.ts",
    "cleanup": "bun src/cleanup/cli/cleanup.ts",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src"
